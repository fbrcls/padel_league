{
  "name": "padel-league",
  "account_id": "cf076240c489481a9a6af3fd7438a1f1",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "APP_ORIGIN": "https://padel-league.lacure.workers.dev",
  },
  "kv_namespaces": [
    {
      "binding": "CONFIRMATION_QUEUE",
      "id": "2a8b1f2753ce4ca1ba60540380c71d7a",
    },
  ],
}
